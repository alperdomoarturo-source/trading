# --- Datos de mercado ---
# La API pública de Binance no requiere clave para datos de mercado.
# Solo cámbialo si usas un mirror/proxy propio:
BINANCE_API_BASE=https://api.binance.com

# --- Supabase (OPCIONAL: la app funciona sin configurarlo) ---
# Crear proyecto gratuito en https://supabase.com y ejecutar las migraciones
# de supabase/migrations (ver supabase/README.md) antes de activar la
# persistencia. Sin estas variables, /api/signals/log devuelve
# { enabled: false }, /api/signals/record y /api/signals/resolve devuelven
# 503 { enabled: false } y todo lo demás sigue igual (localStorage).
#
# RUTA PÚBLICA (lectura desde el navegador conforme a RLS; la clave anon NO
# permite escribir señales: las políticas de escritura no existen para anon):
# NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica
#
# RUTA ADMIN (solo servidor; preferida si ambas existen; bypasea RLS):
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
#
# ADVERTENCIA: SUPABASE_SERVICE_ROLE_KEY NUNCA lleva prefijo NEXT_PUBLIC_ y
# NUNCA se envía al navegador: cualquier valor NEXT_PUBLIC_ queda público en
# el bundle. Esta clave puede saltarse todas las políticas RLS.
# Solo se usa en el servidor (registro de señales y resolución de outcomes):
# SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# --- Aplicación ---
# Desactiva la caché en desarrollo si quieres datos siempre frescos:
# CACHE_DISABLED=false
